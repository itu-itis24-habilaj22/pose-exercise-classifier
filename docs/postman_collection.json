{
  "info": {
    "name": "Personal Trainer AI API",
    "description": "Phase 2B backend. Run 'Signup' or 'Login' first: the token is saved automatically and used by the other requests. See docs/API_DOCUMENTATION.md.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:5000"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "workout_id",
      "value": ""
    },
    {
      "key": "session_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/health",
            "header": [],
            "description": "",
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Signup",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/auth/signup",
            "header": [],
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"faby\",\n  \"email\": \"faby@example.com\",\n  \"password\": \"testpassword1\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.token) { pm.collectionVariables.set('token', body.token); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/auth/login",
            "header": [],
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"faby@example.com\",\n  \"password\": \"testpassword1\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.token) { pm.collectionVariables.set('token', body.token); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/auth/me",
            "header": [],
            "description": ""
          }
        }
      ]
    },
    {
      "name": "Exercises",
      "item": [
        {
          "name": "List exercises",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/exercises",
            "header": [],
            "description": "",
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    },
    {
      "name": "Workouts",
      "item": [
        {
          "name": "List workouts",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/workouts",
            "header": [],
            "description": ""
          }
        },
        {
          "name": "Create workout",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/workouts",
            "header": [],
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Monday Push Day\",\n  \"exercises\": [\n    {\n      \"exercise\": \"pushup\",\n      \"sets\": 3,\n      \"target_reps\": 10\n    },\n    {\n      \"exercise\": \"curl\",\n      \"sets\": 3,\n      \"target_reps\": 12\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.workout) { pm.collectionVariables.set('workout_id', body.workout.workout_id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Get workout",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/workouts/{{workout_id}}",
            "header": [],
            "description": ""
          }
        },
        {
          "name": "Update workout",
          "request": {
            "method": "PUT",
            "url": "{{base_url}}/api/workouts/{{workout_id}}",
            "header": [],
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Leg Day\",\n  \"exercises\": [\n    {\n      \"exercise\": \"squat\",\n      \"sets\": 4,\n      \"target_reps\": 8\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Delete workout",
          "request": {
            "method": "DELETE",
            "url": "{{base_url}}/api/workouts/{{workout_id}}",
            "header": [],
            "description": ""
          }
        }
      ]
    },
    {
      "name": "History and stats",
      "item": [
        {
          "name": "Save result",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/history",
            "header": [],
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"exercise\": \"squat\",\n  \"reps_completed\": 12,\n  \"duration\": 45,\n  \"form_score\": 88,\n  \"voice_enabled\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "List history",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/history?exercise=squat",
            "header": [],
            "description": ""
          }
        },
        {
          "name": "Stats",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/stats",
            "header": [],
            "description": ""
          }
        },
        {
          "name": "Progress (premium)",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/progress?days=30",
            "header": [],
            "description": ""
          }
        }
      ]
    },
    {
      "name": "Detection",
      "item": [
        {
          "name": "Start session",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/detect/sessions",
            "header": [],
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"exercise\": \"pushup\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.session_id) { pm.collectionVariables.set('session_id', body.session_id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Send frame",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/detect/sessions/{{session_id}}/frames",
            "header": [],
            "description": "In Body > form-data, choose an image file (JPEG/PNG) for the 'frame' field.",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "frame",
                  "type": "file",
                  "src": []
                }
              ]
            }
          }
        },
        {
          "name": "End session",
          "request": {
            "method": "DELETE",
            "url": "{{base_url}}/api/detect/sessions/{{session_id}}",
            "header": [],
            "description": ""
          }
        }
      ]
    }
  ]
}