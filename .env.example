# Copy this file to .env (which git ignores) and fill in your own values.

# PostgreSQL connection: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/personal_trainer

# Long random text used to sign login tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me
